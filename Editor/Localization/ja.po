msgid ""
msgstr ""
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ja\n"

msgid "Animator Controller"
msgstr "アニメーターコントローラー"

msgid "Avatar"
msgstr "アバター"

msgid ""
"An avatar object to configure.\n"
"Please put what contains VRC Avatar Descriptor in hierarchy."
msgstr ""
"設定するアバターのオブジェクトです。\n"
"ヒエラルキー上のVRC Avatar Descriptorが付与されているものを入れてください。"

msgid ""
"Avatar is not specified.\n"
"Please specify avatar object."
msgstr ""
"アバターが指定されていません。\n"
"アバターを指定してください。"

msgid "Facial expression animation (Face)"
msgstr "なで表情アニメーション(顔)"

msgid "An animation of facial expression that is used when avatar's face is patted."
msgstr "顔をなでられた時の表情アニメーションです。"

msgid "Facial expression animation (Left ear)"
msgstr "なで表情アニメーション(左耳)"

msgid "An animation of facial expression that is used when avatar's left ear is touched."
msgstr "左耳を触られた時の表情アニメーションです。"

msgid "Facial expression animation (Right ear)"
msgstr "なで表情アニメーション(右耳)"

msgid "An animation of facial expression that is used when avatar's right ear is touched."
msgstr "右耳を触られた時の表情アニメーションです。"

msgid "Facial expression animation (Chest)"
msgstr "なで表情アニメーション(胸)"

msgid "An animation of facial expression that is used when avatar's chest is touched."
msgstr "胸を触られた時の表情アニメーションです。"

msgid "Facial expression animation (Crotch)"
msgstr "なで表情アニメーション(股間)"

msgid "An animation of facial expression that is used when avatar's crotch is touched."
msgstr "股間を触られた時の表情アニメーションです。"

msgid "Reset"
msgstr "リセット"

msgid "Set facial expression animation to dummy."
msgstr "なで表情アニメーションをダミーへ戻します。"

msgid "Nade Face Gimmick Avatar Settings"
msgstr "なで表情ギミックアバター設定"

msgid "Nade Face Gimmick Profiles"
msgstr "なで表情ギミックプロファイル"

msgid "Profile"
msgstr "プロファイル"

msgid "A profile of Nade Face Gimmick."
msgstr "なで表情ギミックのプロファイルです。"

msgid "Create profile"
msgstr "プロファイル作成"

msgid "Create new Nade Face Gimmick profile."
msgstr "新しいなで表情ギミックプロファイルを作成します。"

msgid "Profile name"
msgstr "プロファイル名"

msgid "A profile name to create."
msgstr "作成するプロファイルの名前です。"

msgid ""
"Nade Face Gimmick is not installed in the avatar.\n"
"Please install it."
msgstr ""
"アバターになで表情ギミックがインストールされていません。\n"
"インストールしてください。"

msgid ""
"This avatar is not set Nade Face Gimmick profile.\n"
"Please set in the following field."
msgstr ""
"このアバターにはなで表情ギミックプロファイルが設定されていません。\n"
"下記欄から設定してください。"

msgid "(Create new profile)"
msgstr "(新しくプロファイルを作成する)"

msgid "This profile must be converted to new style."
msgstr "このプロファイルは新しい形式へ変換する必要があります。"

msgid "Convert profile"
msgstr "プロファイルを変換"

msgid "Convert to new style profile."
msgstr "プロファイルを新しい形式へ変換します。"
